<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
    <title>Home - Blogs</title>
    <style>
        /* Custom enhancements for a premium blog feed */
        body {
            background-color: #f8f9fa;
            color: #333;
        }
        .feed-header {
            margin: 40px 0 30px;
            text-align: center;
        }
        .feed-header h1 {
            font-weight: 800;
            color: #212529;
            letter-spacing: -0.5px;
        }
        .feed-header p {
            color: #6c757d;
            font-size: 1.1rem;
        }
        .blog-card {
            border: none;
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            overflow: hidden;
            height: 100%;
        }
        .blog-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }
        .blog-card-img {
            height: 200px;
            object-fit: cover;
            width: 100%;
        }
        .card-body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
        }
        .card-title {
            font-weight: 700;
            font-size: 1.15rem;
            color: #2c3e50;
            margin-bottom: 15px;
            display: -webkit-box;
            line-clamp: 2;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .btn-outline-primary-custom {
            border: 2px solid #0d6efd;
            color: #0d6efd;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.2s ease;
        }
        .btn-outline-primary-custom:hover {
            background-color: #0d6efd;
            color: #fff;
        }
    </style>
</head>

<body>

    <%- include('./partial/Navbsr') %>

    <div class="container my-5">
        <!-- Feed Title Header -->
        <div class="feed-header">
            <h1>Discover Stories & Ideas</h1>
            <p>Explore the latest blog posts shared by our community.</p>
        </div>

        <!-- Responsive Grid -->
        <div class="row g-4">
            <% blogs.forEach(blog => { %>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card blog-card">
                        <img src="<%= blog.coverImageURL %>" class="card-img-top blog-card-img" alt="<%= blog.title %>">
                        <div class="card-body">
                            <h5 class="card-title"><%= blog.title %></h5>
                            <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary-custom w-100 py-2">Read Article</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <%- include('./partial/script') %>
</body>

</html>