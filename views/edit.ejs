<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
    <title>Edit Blog - Blogs</title>
</head>

<body>

    <%- include('./partial/Navbsr') %>

    <div class="container mt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                
                <!-- Card Container -->
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        
                        <h2 class="mb-4 text-center fw-bold">Edit Blog Post</h2>

                        <form action="/blog/<%= blog._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
  <input type="text" name="title" value="<%= blog.title %>" required>
  <textarea name="body" required><%= blog.body %></textarea>

  <img src="<%= blog.coverImageURL %>" alt="Current cover" width="200">
  <label>Replace cover (optional)</label>
  <input type="file" name="coverImage" accept="image/*">
  <button type="submit">Save changes</button>
</form>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <%- include('./partial/script') %>
</body>

</html>