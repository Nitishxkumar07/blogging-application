<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
    <title>Sign Up - Community Blog</title>
    <style>
        /* Custom enhancements and animations for Sign Up */
        body {
            background-color: #f8f9fa;
            color: #333;
            overflow-x: hidden;
        }
        
        /* Smooth Entrance Animation */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .auth-container {
            max-width: 480px;
            background: #ffffff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            margin-top: 60px;
            margin-bottom: 60px;
            animation: fadeInUp 0.6s ease-out forwards;
        }
        .form-label {
            font-weight: 600;
            color: #495057;
        }
        .form-control {
            border-radius: 8px;
            padding: 10px 15px;
            border: 1px solid #ced4da;
            transition: all 0.2s ease;
        }
        .form-control:focus {
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
            border-color: #86b7fe;
        }
        .auth-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .auth-header h2 {
            font-weight: 800;
            color: #212529;
            letter-spacing: -0.5px;
        }
        .auth-header p {
            color: #6c757d;
            font-size: 0.95rem;
        }
        .form-text {
            color: #adb5bd !important;
        }
        .btn-primary {
            transition: transform 0.2s ease, background-color 0.2s ease;
        }
        .btn-primary:active {
            transform: scale(0.98);
        }
    </style>
</head>

<body>

    <%- include('./partial/Navbsr') %>

    <div class="container d-flex justify-content-center">
        <div class="auth-container w-100">
            
            <!-- Auth Header -->
            <div class="auth-header">
                <h2>Create an Account</h2>
                <p>Join our community and start sharing your stories.</p>
            </div>

            <!-- Sign Up Form -->
            <form method="post" action="/user/signup">
                
                <!-- Full Name -->
                <div class="mb-3">
                    <label for="fullName" class="form-label">Full Name</label>
                    <input type="text" class="form-control" id="fullName" name="fullName" placeholder="John Doe" aria-describedby="Name" required>
                </div>
                
                <!-- Email Address -->
                <div class="mb-3">
                    <label for="exampleInputEmail1" class="form-label">Email Address</label>
                    <input type="email" class="form-control" id="exampleInputEmail1" name="email" placeholder="name@example.com" aria-describedby="emailHelp" required>
                    <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
                </div>
                
                <!-- Password -->
                <div class="mb-4">
                    <label for="exampleInputPassword1" class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" id="exampleInputPassword1" placeholder="••••••••" required>
                </div>
                
                <!-- Submit Button -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary py-2 fw-semibold fs-5">Sign Up</button>
                </div>

            </form>
            
        </div>
    </div>

    <%- include('./partial/script') %>
</body>

</html>